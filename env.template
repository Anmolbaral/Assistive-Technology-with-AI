# Environment Variables Template for Vercel Deployment
# Copy this to .env.local and fill in your values

# Supabase Database Configuration (get from your Supabase dashboard)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?sslmode=require

# OpenAI API Key
OPENAI_API_KEY=sk-...

# RAG Configuration
RAG_MODEL=gpt-4o-mini
RAG_MAX_TOKENS=2000

# Analytics (optional)
PLAUSIBLE_DOMAIN=your-domain.com

# Development
NODE_ENV=development
